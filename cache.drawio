        <mxCell id="R0RBcUybxsGhWG_bY4Bf-14" value="&lt;b&gt;auction-service&lt;/b&gt;&lt;div&gt;send_response_to_client&lt;/div&gt;&lt;div&gt;::SakaniAsyncCommand::BaseCommand.response_to_client!(...expires_in: 1.day)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;" parent="1" vertex="1">
